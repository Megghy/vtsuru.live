:80 {
  encode gzip zstd
  root * /etc/caddy/html/

  # hashed 资源缺失必须 404，禁止回退成 index.html（否则 MIME 变成 text/html）
  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    try_files {path} /index.html
    header Cache-Control "no-cache, no-store, must-revalidate"
    file_server
  }
}
