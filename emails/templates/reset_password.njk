{% extends "../_layouts/base.njk" %}
{% from "../_partials/action_button.njk" import action_button %}
{% from "../_partials/fallback_link.njk" import fallback_link %}
{% set title = "重设密码" %}
{% set subtitle = "重设密码" %}
{% set preview = "您请求了重设 " + site_name + " 的密码。" %}

{% block body %}
<p style="margin:0 0 8px;font-size:16px;color:#2d3748;font-weight:600;">您好，{{username}}</p>
<p style="margin:0 0 24px;font-size:15px;color:#4a5568;line-height:1.6;">
  我们收到了重设您 {{site_name}} 账户密码的请求。请点击下方按钮设置新密码。
</p>

[[ action_button("{{reset_link}}", "重设密码") ]]
[[ fallback_link("{{reset_link}}", "{{valid_duration}}") ]]

<div style="border-top:1px solid #e8edf5;margin-bottom:20px;"></div>
<p style="margin:0 0 32px;font-size:13px;color:#a0aec0;line-height:1.6;">
  如果您没有请求重设密码，请忽略此邮件，您的密码将保持不变。
</p>
{% endblock %}
