{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": ["src/**/*.{ts,tsx,js,jsx,vue}", "scripts/*.mjs"],
  "ignore": ["src/api/generated/**"],
  "ignoreDependencies": [
    "@playwright/test",
    "@unocss/preset-wind3",
    "dayjs",
    "playwright",
    "playwright-core",
    "shadcn-vue"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "enumMembers": "off"
  },
  "paths": {
    "@/*": ["./src/*"]
  }
}
